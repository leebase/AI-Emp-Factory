{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "Three authorities, enforced separately (D309/D310). The runtime root is wider than any one of them so all three are physically reachable; this policy decides what may actually be done in each. Wide root is implementation sequence, not the security model. Reachability must not imply authority: a workspace this session can see but no grant names is denied here.",
  "_home": "chief",
  "permission": {
    "edit": {
      "*": "deny",
      "chief/journal/**": "allow",
      "chief/outputs/**": "allow",
      "chief/state/**": "allow",
      "chief/decisions.md": "allow",
      "chief/AGENTS.md": "deny",
      "chief/README.md": "deny",
      "chief/opencode.json": "deny",
      "chief/state/assignment.json": "deny",
      "factory/employees/ordinary/AGENTS.md": "deny",
      "factory/hiring/**": "deny",
      "factory/employees/ordinary/factory-records-clerk/**": "deny",
      "factory/employees/ordinary/documentation-steward/**": "deny",
      "factory/employees/ordinary/document-publisher/**": "deny",
      "user/**": "allow",
      "user/config/**": "deny",
      "user/board/**": "deny",
      "user/runtime/**": "deny",
      "board/**": "deny",
      "bin/**": "deny",
      "AGENTS.md": "deny",
      "CLAUDE.md": "deny",
      "INSTALL.md": "deny",
      "router/**": "deny",
      "schemas/**": "deny",
      "stage-workers/**": "deny"
    },
    "bash": {
      "*": "deny",
      "lee-llm-router *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git -C *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sed -n *": "allow",
      "find *": "allow",
      "python3 -m pytest*": "allow",
      "pwd": "allow",
      "claude*": "deny",
      "codex*": "deny",
      "agy*": "deny",
      "opencode*": "deny",
      "omp*": "deny",
      "pi*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git checkout*": "deny",
      "git reset*": "deny",
      "bin/lee-llm-router *": "allow",
      "./bin/lee-llm-router *": "allow",
      "bin/board-runtime status*": "allow",
      "./bin/board-runtime status*": "allow",
      "./bin/board-worker *": "allow",
      "bin/board-worker *": "allow",
      "bin/board-runtime delegate create *": "allow",
      "bin/board-runtime delegate status *": "allow",
      "bin/board-runtime delegate close *": "allow",
      "bin/board-runtime delegate record *": "allow",
      "./bin/board-runtime delegate create *": "allow",
      "./bin/board-runtime delegate status *": "allow",
      "./bin/board-runtime delegate close *": "allow",
      "./bin/board-runtime delegate record *": "allow"
    },
    "task": "deny"
  },
  "_distribution_note": "Paths are relative to the distribution root. Open a session with the working directory set to the root, not to chief/, so these rules resolve."
}